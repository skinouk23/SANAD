# Care@Home Tunisia — Environment Variables
# Copy this file to .env and fill in real values.
# See src/config/env.ts for defaults and validation logic.

# ── Country & Localization ──────────────────────────
VITE_COUNTRY_CODE=TN
VITE_DEFAULT_LOCALE=fr-FR

# ── API Configuration ───────────────────────────────
# Default: same-origin API base that works with the Vite dev proxy.
VITE_API_BASE_URL=/api/v1
# Optional absolute override for non-proxy environments:
# VITE_API_BASE_URL=https://api.careathome.tn/api/v1
VITE_API_TIMEOUT=5000
VITE_API_RETRY_ATTEMPTS=2
VITE_API_RETRY_DELAY=500

# ── Feature Flags ───────────────────────────────────
# Safe default: real backend mode. Enable mocks explicitly in local dev only.
VITE_ENABLE_MOCK_DATA=false
VITE_ENABLE_DEBUG_MODE=false
VITE_SHOW_QUERY_DEVTOOLS=false

# Local mock example:
# VITE_ENABLE_MOCK_DATA=true

# ── App Info ────────────────────────────────────────
VITE_APP_NAME=Care@Home Tunisia
VITE_APP_VERSION=1.0.0

# ── External Services (optional) ────────────────────
# VITE_GOOGLE_MAPS_API_KEY=

# ── Non-Vite keys (not exposed to browser) ──────────
# GEMINI_API_KEY=
