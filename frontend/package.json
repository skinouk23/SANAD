{
  "name": "care-at-home-tunisia",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build --manifest",
    "build:report": "node ./scripts/performance-report.mjs",
    "build:budget": "node ./scripts/performance-report.mjs --budget",
    "preview": "vite preview",
    "test": "vitest",
    "type-check": "tsc --noEmit",
    "lint": "eslint . && npm run lint:cycles",
    "lint:cycles": "node ./scripts/check-booking-provider-cycles.mjs",
    "ci:verify": "npm run lint && npm run type-check && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
