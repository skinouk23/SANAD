{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "SanadPlatform": "Information"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=your-postgres-server;Port=5432;Database=sanad_platform;Username=postgres;Password=;",
    "LoggingDatabase": "Host=your-postgres-server;Port=5432;Database=sanad_platform_logs;Username=postgres;Password=;"
  },
  "JwtSettings": {
    "SecretKey": "",
    "Issuer": "SanadPlatform",
    "Audience": "SanadPlatformAPI",
    "ExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 30
  },
  "CorsSettings": {
    "AllowedOrigins": [
      "https://yourdomain.com",
      "https://api.yourdomain.com"
    ]
  },
  "RedisSettings": {
    "Enabled": true,
    "Connection": "your-redis-server:6379"
  },
  "MinioSettings": {
    "Endpoint": "127.0.0.1:9000",
    "AccessKey": "",
    "SecretKey": "",
    "UseSSL": false,
    "Region": ""
  },
  "FileStorage": {
    "StagingBucket": "files-staging",
    "PrivateBucket": "files-private",
    "PublicBucket": "files-public",
    "QuarantineBucket": "files-quarantine",
    "ExportsBucket": "files-exports",
    "DefaultMaxUploadBytes": 26214400,
    "StreamCopyBufferBytes": 131072,
    "MaxFileNameLength": 500
  },
  "RabbitMQ": {
    "Enabled": true,
    "HostName": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "UserName": "sanad",
    "Password": "",
    "UseTls": false,
    "ExchangeName": "sanad.files",
    "DeadLetterExchangeName": "sanad.files.dlx",
    "UseQuorumQueues": true,
    "PublisherConfirms": true,
    "PrefetchCount": 4,
    "MaxPublishAttempts": 10,
    "PublishBatchSize": 25
  },
  "FileWorkers": {
    "OutboxPublisherEnabled": true,
    "ScanWorkerEnabled": false,
    "CleanupWorkerEnabled": false,
    "DerivativeWorkerEnabled": false,
    "ExportWorkerEnabled": false,
    "PollIntervalSeconds": 10,
    "CleanupPollIntervalSeconds": 300,
    "MessageLockSeconds": 120
  },
  "FileScanner": {
    "Provider": "ClamAv",
    "AllowUnsafeNoopScanner": false,
    "ClamAvHost": "localhost",
    "ClamAvPort": 3310,
    "TimeoutSeconds": 30,
    "MaxScanBytes": 104857600
  },
  "ProviderSignupUploadTokens": {
    "SigningKey": "",
    "ExpirationMinutes": 30,
    "MaxFilesPerApplication": 20
  },
  "Security": {
    "DataInTransit": {
      "EnforceHsts": true,
      "HstsMaxAge": 31536000,
      "HstsIncludeSubDomains": true,
      "HstsPreload": true,
      "MinimumTlsVersion": "1.2",
      "EnforceSecureCookies": true,
      "EnableCertificatePinning": false
    },
    "CertificatePinning": {
      "Thumbprints": []
    }
  }
}
