{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
   "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=sanad;Username=postgres;Password=;",
    "LoggingDatabase": "Host=localhost;Port=5432;Database=sanad_platform_logs;Username=postgres;Password=;"
  },
  "JwtSettings": {
    "SecretKey": "",
    "Issuer": "SanadPlatform",
    "Audience": "SanadPlatformAPI",
    "ExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 30
  },
  "LoginOtpSettings": {
    "CodeLength": 6,
    "ExpirationSeconds": 300,
    "ResendCooldownSeconds": 60,
    "MaxFailedAttempts": 5,
    "CodeHashSecret": ""
  },
  "Email": {
    "SmtpServer": "smtp.gmail.com",
    "SmtpPort": 587,
    "SenderEmail": "smtp@example.invalid",
    "SenderPassword": "",
    "SenderName": "Sanad",
    "UseStartTls": true
  },
  "Sms": {
    "Provider": "TunisieSMS",
    "Enabled": false,
    "ApiUrl": "",
    "ClientId": "",
    "ApiKey": "",
    "SenderName": "SANAD",
    "DefaultCountryCode": "TN"
  },
  "CorsSettings": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:3000",
      "https://localhost:5173",
      "http://localhost:4173"
    ]
  },
  "RedisSettings": {
    "Enabled": false,
    "Connection": "localhost:6379"
  },
  "WebPush": {
    "Subject": "mailto:admin@sanad.local",
    "PublicKey": "",
    "PrivateKey": ""
  },
  "MinioSettings": {
    "Endpoint": "127.0.0.1:9000",
    "AccessKey": "",
    "SecretKey": "",
    "UseSSL": false,
    "Region": ""
  },
  "FileStorage": {
    "StagingBucket": "files-staging",
    "PrivateBucket": "files-private",
    "PublicBucket": "files-public",
    "QuarantineBucket": "files-quarantine",
    "ExportsBucket": "files-exports",
    "DefaultMaxUploadBytes": 26214400,
    "StreamCopyBufferBytes": 131072,
    "MaxFileNameLength": 500
  },
  "RabbitMQ": {
    "Enabled": true,
    "HostName": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "UserName": "sanad",
    "Password": "",
    "UseTls": false,
    "ExchangeName": "sanad.files",
    "DeadLetterExchangeName": "sanad.files.dlx",
    "UseQuorumQueues": true,
    "PublisherConfirms": true,
    "PrefetchCount": 4,
    "MaxPublishAttempts": 10,
    "PublishBatchSize": 25
  },
  "FileWorkers": {
    "OutboxPublisherEnabled": true,
    "ScanWorkerEnabled": false,
    "CleanupWorkerEnabled": false,
    "DerivativeWorkerEnabled": false,
    "ExportWorkerEnabled": false,
    "PollIntervalSeconds": 10,
    "CleanupPollIntervalSeconds": 300,
    "MessageLockSeconds": 120
  },
  "FileScanner": {
    "Provider": "ClamAv",
    "AllowUnsafeNoopScanner": false,
    "ClamAvHost": "localhost",
    "ClamAvPort": 3310,
    "TimeoutSeconds": 30,
    "MaxScanBytes": 104857600
  },
  "ProviderSignupUploadTokens": {
    "SigningKey": "",
    "ExpirationMinutes": 30,
    "MaxFilesPerApplication": 20
  },
  "Security": {
    "EncryptionKey": "",
    "DataInTransit": {
      "EnforceHsts": true,
      "HstsMaxAge": 31536000,
      "HstsIncludeSubDomains": true,
      "HstsPreload": true,
      "MinimumTlsVersion": "1.2",
      "EnforceSecureCookies": true,
      "EnableCertificatePinning": false
    },
    "CertificatePinning": {
      "Thumbprints": []
    }
  }
}
