## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# Visual Studio cache/options directory
.vs/

# Visual Studio Code
.vscode/
*.code-workspace

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio cache files
*.ldf
*.lock

# Entity Framework
*.db
*.db-shm
*.db-wal
# User Secrets
secrets.json
appsettings.secrets.json

# Test Results
TestResults/
*.trx

# NuGet
*.nupkg
*.snupkg
.nuget/

# Local environment files
.env
.env.local
.env.*.local

# Node modules (if any frontend tools)
node_modules/

# OS files
.DS_Store
Thumbs.db

# IDE
*.swp
*.swo
*~

# Rider
.idea/
*.iml

# ReSharper
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# Coverage reports
coverage/
*.coverage

/conductor/
AGENTS.md
GEMINI.md
.agent

# ── GSD baseline (auto-generated) ──
.gsd
.env.*
!.env.example
.next/
dist/
build/
__pycache__/
*.pyc
