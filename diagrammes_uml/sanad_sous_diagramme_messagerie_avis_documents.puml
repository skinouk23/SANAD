@startuml
title Sous-diagramme - Messagerie, avis et documents

left to right direction
skinparam shadowing false
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam packageTitleAlignment center
skinparam classAttributeIconSize 0
skinparam defaultFontName "Times New Roman"
skinparam ClassBackgroundColor White
skinparam ClassBorderColor Black
skinparam PackageBackgroundColor White
skinparam PackageBorderColor Black

hide empty methods
hide circle

class "users" as users {
  +id : UUID <<PK>>
  +role : varchar
}

class "patients" as patients {
  +id : UUID <<PK>>
  +user_id : UUID <<FK>>
}

class "providers" as providers {
  +id : UUID <<PK>>
  +user_id : UUID <<FK>>
}

class "bookings" as bookings {
  +id : UUID <<PK>>
  +patient_id : UUID <<FK>>
  +provider_id : UUID <<FK>>
  +service_id : UUID
  +status : varchar(50)
}

class "conversations" as conversations {
  +id : UUID <<PK>>
  +patient_id : UUID <<FK>>
  +provider_id : UUID <<FK>>
  +is_active : boolean
  +last_message_at : timestamptz?
  +patient_unread_count : int
  +provider_unread_count : int
}

class "messages" as messages {
  +id : UUID <<PK>>
  +conversation_id : UUID <<FK>>
  +sender_id : UUID <<FK>>
  +message_type : varchar(20)
  +content : text
  +is_read : boolean
  +read_at : timestamptz?
}

class "reviews" as reviews {
  +id : UUID <<PK>>
  +booking_id : UUID <<FK>>
  +patient_id : UUID <<FK>>
  +provider_id : UUID <<FK>>
  +service_id : UUID
  +rating : int
  +provider_response : text?
  +is_visible : boolean
}

class "review_reports" as review_reports {
  +id : UUID <<PK>>
  +review_id : UUID <<FK>>
  +reported_by : UUID
  +reason : varchar(100)
  +status : varchar(20)
  +resolved_by : UUID?
}

class "documents" as documents {
  +id : UUID <<PK>>
  +owner_id : UUID
  +owner_type : varchar
  +document_type : varchar
  +storage_bucket : varchar(63)
  +storage_path : varchar(1024)
  +related_patient_id : UUID <<FK>>?
  +related_provider_id : UUID <<FK>>?
  +related_appointment_id : UUID <<FK>>?
}

patients "1" -- "0..*" conversations : patient_id
providers "1" -- "0..*" conversations : provider_id
conversations "1" -- "0..*" messages : conversation_id
users "1" -- "0..*" messages : sender_id

bookings "1" -- "0..1" reviews : booking_id
patients "1" -- "0..*" reviews : patient_id
providers "1" -- "0..*" reviews : provider_id
reviews "1" -- "0..*" review_reports : review_id

patients "0..1" -- "0..*" documents : related_patient_id
providers "0..1" -- "0..*" documents : related_provider_id
bookings "0..1" -- "0..*" documents : related_appointment_id

note right of reviews
service_id existe dans la table reviews,
mais aucune relation EF Core explicite n'est configuree vers services.
end note

note right of documents
owner_id est polymorphe et depend de owner_type.
Il ne correspond pas a une cle etrangere directe.
end note

note bottom of review_reports
reported_by et resolved_by sont stockes,
mais aucune relation EF Core n'est definie vers users.
end note

@enduml
